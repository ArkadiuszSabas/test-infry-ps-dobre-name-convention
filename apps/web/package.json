{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "dev:turbopack": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "build:turbopack": "next build --turbopack",
    "start": "next start",
    "format": "prettier --check \"src/**/*.{css,ts,tsx}\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.{json,md,mjs,ts}\" \".dependency-cruiser.cjs\"",
    "format:fix": "prettier --write \"src/**/*.{css,ts,tsx}\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.{json,md,mjs,ts}\" \".dependency-cruiser.cjs\"",
    "lint": "eslint src tests *.config.ts next.config.ts postcss.config.mjs eslint.config.mjs .dependency-cruiser.cjs --cache --cache-location node_modules/.cache/eslint/.eslintcache --max-warnings=0",
    "lint:fix": "eslint src tests *.config.ts next.config.ts postcss.config.mjs eslint.config.mjs .dependency-cruiser.cjs --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "arch": "depcruise --config .dependency-cruiser.cjs --cache --cache-strategy content --output-type err src tests",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.12.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "17.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
